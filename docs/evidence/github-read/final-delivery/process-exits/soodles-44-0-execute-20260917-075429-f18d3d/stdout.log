ptance':'Supervisor-owned existing exact-head evidence; not rerun on macOS','typed_schema_source':{'revision':revision,'path':'event/types.go','sha256':hashlib.sha256(schema).hexdigest()},'observed_at_unix':time.time()}\n(out/'verification-summary.json').write_text(json.dumps(summary,indent=2)+'\\\\n')\npayload={'message':'Verification blocked for clean candidate '+head+': reader tests 15 passed, 1 error because sandbox denied local socket bind (PermissionError EPERM) in redirect control; consumer 16/16 passed; live authenticated Issue 44 HTTP 200 then 304 with identical bytes, no-token refusal GREEN, temporary cache removed. Evidence: '+str(out)+'. Supervisor must supply carrier allowing loopback bind; no unchanged retry, source changes, commits or provider writes. This outcome covers verification stage only.','blocking':True,'outcome':'blocked','order_id':os.environ['NOODLE_ORDER_ID'],'stage_index':int(os.environ['NOODLE_STAGE_INDEX'])}\nassert os.environ['NOODLE_SESSION_ID']==identity['NOODLE_SESSION_ID']\n(out/'stage-message-payload.json').write_text(json.dumps(payload,indent=2)+'\\\\n')\nargv=[binary,'event','emit','stage_message','--session',os.environ['NOODLE_SESSION_ID'],'--payload',json.dumps(payload)]\nstart=time.monotonic()\np=subprocess.run(argv,capture_output=True)\n(out/'event-emit.stdout').write_bytes(p.stdout)\n(out/'event-emit.stderr').write_bytes(p.stderr)\n(out/'event-emit.json').write_text(json.dumps({'session_id':os.environ['NOODLE_SESSION_ID'],'event_type':'stage_message','payload':payload,'command_exit_code':p.returncode,'elapsed_seconds':time.monotonic()-start},indent=2)+'\\\\n')\nprint(json.dumps({'typed_outcome':'blocked','blocking':True,'event_emit_exit_code':p.returncode,'evidence':str(out)}))\nif p.returncode:\n print(p.stderr.decode())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
