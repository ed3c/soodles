{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport os,json,hashlib,subprocess,time,pathlib,tempfile,shutil\nout=pathlib.Path('/Users/neon/.codex/experiments/soodles44-delivery-20260917/worker-evidence')\ncache=pathlib.Path(tempfile.mkdtemp(prefix='soodles44-worker-cache-'))\nreceipt={'authorizes_landing':False,'cache_path':str(cache),'checks':{},'calls':[]}\ndef save():\n (out/'live-receipt.json').write_text(json.dumps(receipt,indent=2)+'\\\\n')\ndef call(name,env):\n start=time.monotonic(); started=time.time()\n p=subprocess.run(['./soodles','github','issue','44'],env=env,capture_output=True,timeout=45)\n token=[REDACTED_SECRET]'GH_TOKEN','').encode()\n if token and (token in p.stdout or token in p.stderr):\n  raise RuntimeError('secret detected in output; raw evidence withheld')\n (out/(name+'.stdout')).write_bytes(p.stdout)\n (out/(name+'.stderr')).write_bytes(p.stderr)\n record={'name':name,'argv':['./soodles','github','issue','44'],'exit_code':p.returncode,'elapsed_seconds':time.monotonic()-start,'started_at_unix':started}\n receipt['calls'].append(record); save()\n value=json.loads(p.stdout)\n record['observation']=value.get('observation');record['status']=value.get('status');record['next']=value.get('next');save()\n return p,value\ntry:\n env=dict(os.environ);env['XDG_CACHE_HOME']=str(cache);env['PYTHONDONTWRITEBYTECODE']='1'\n assert env.get('GH_TOKEN'), 'supervisor credential missing'\n prior=None\n for n,status in [(1,200),(2,304)]:\n  p,value=call('live-cli-'+str(n),env)\n  assert p.returncode==0 and value.get('status')=='read', 'live reader refused or waiting; preserve next, no retry'\n  obs=value['observation']\n  assert obs['authenticated'] is True and obs['status']==status, 'unexpected authenticated HTTP status; no retry'\n  issue=value['issue']\n  assert type(issue['number']) is int and issue['number']==44\n  assert issue['url']=='https://api.github.com/repos/ed3c/soodles/issues/44'\n  assert hashlib.sha256(issue['body'].encode()).hexdigest()=='4c9f5b0c5116fa62bbe993c651cdf2f01c5e2519b68b982b8785a7cabd015871'\n  paths=[p for p in cache.rglob('*.json') if p.name\"'!='\"'budget.json']\n  assert len(paths)==1\n  raw=json.loads(paths[0].read_text())['body'].encode()\n  assert json.loads(raw)==issue\n  (out/('issue-'+str(n)+'.json')).write_bytes(raw)\n  receipt['checks']['http_'+str(status)]=True\n  receipt['checks']['issue_'+str(n)+'_sha256']=hashlib.sha256(raw).hexdigest()\n  if prior is not None:\n   assert raw==prior,'Issue bytes changed'\n   receipt['checks']['identical_issue_bytes']=True\n  prior=raw\n  save()\n no_token={k:v for k,v in env.items() if k\"'!='\"'GH_TOKEN'}\n p,value=call('no-token-cli',no_token)\n assert p.returncode\"'!=0 and value['\"'status']=='refused'\n assert value['invalid']['field']=='github.credential'\n assert value['next']['owner']=='supervisor'\n receipt['checks']['no_token_correct_refusal_green']=True\n receipt['status']='passed'\nexcept Exception as error:\n receipt['status']='blocked';receipt['failure']=str(error)\nfinally:\n shutil.rmtree(cache)\n receipt['cleanup']={'removed_only_temporary_cache':str(cache),'cache_absent':not cache.exists(),'observed_at_unix':time.time()}\n save()\nprint(json.dumps(receipt,indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
