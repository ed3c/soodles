        "physical_costs": "Owner validation and source checks remain outside hot operations. Test Manager logs include fixture process/config costs; production I/O is not measured.",
        "reproduction_python": "from pathlib import Path\nimport copy\nimport json\nimport math\nimport platform\nimport sys\nfrom time import perf_counter_ns\n\nroot = Path.cwd()\nsys.path.insert(0, str(root))\nimport schema_manager\n\nout = root / 'docs/experiments/schema-plan-fields'\nverification = json.loads((out / 'results.json').read_text())['verification_rounds'][0]\nresponses = []\nfor line in (verification['stdout'] + '\\n' + verification['stderr']).splitlines():\n    if line.startswith('{'):\n        try:\n            value = json.loads(line)\n        except ValueError:\n            continue\n        if value.get('event') == 'schema_plan_fields.owner_response':\n            responses.append(value['response'])\nassert len(responses) == 1\ncarrier = platform.system().lower() + '_' + platform.machine()\nassert carrier == 'darwin_arm64', carrier\ncold_start = perf_counter_ns()\nplan = schema_manager.compile_plan(root)\ncold_ns = perf_counter_ns() - cold_start\nrecord = responses[0]['host_finalization']\nassert record['identity']['plan'] == plan.identity\nowner = schema_manager.Manager(plan, record['identity'], record)\n# Vary one trusted-event fixture input. This is a deterministic simulation,\n# not a new physical claim. All other observations come from actual finish_host.\ntemplates = []\nfor allowed in (False, True):\n    facts = copy.deepcopy(record['facts'])\n    facts['cleanup_allowed']['value'] = allowed\n    facts['cleanup_allowed']['evidence'] = schema_manager.digest({'timing_fixture_cleanup_allowed': allowed})\n    templates.append(facts)\nevents = [{'identity': record['identity'], 'sequence': record['sequence'] + i + 1,\n           'facts': templates[i % 2]} for i in range(1100)]\ninitial_record = copy.deepcopy(record)\nfor event in events[:100]:\n    owner.apply(event)\n    owner.project()\nsamples = []\nfor event in events[100:]:\n    start = perf_counter_ns()\n    owner.apply(event)\n    owner.project()\n    samples.append(perf_counter_ns() - start)\nordered = sorted(samples)\nsummary = {'p50': ordered[math.ceil(len(ordered) * .50) - 1],\n           'p95': ordered[math.ceil(len(ordered) * .95) - 1], 'max': max(samples)}\nreceipt = {'schema': 1, 'carrier': carrier, 'python': sys.version,\n           'plan_identity': plan.identity, 'source_sha256': plan.sources,\n           'warmups': 100, 'operations': 1000, 'clock': 'perf_counter_ns',\n           'operation': 'apply(event), including its returned projection, followed by project()',\n           'event_fixture': {'initial_record': initial_record, 'fact_templates': templates,\n                             'sequence': 'initial_record.sequence + i + 1',\n                             'template_index': 'i % 2', 'i': '0..1099'},\n           'samples_ns': samples, 'percentiles_ns': summary,\n           'percentile_method': 'nearest rank', 'target_p95_ns': 10000000,\n           'target_met': summary['p95'] <= 10000000,\n           'cold_compile_ns_separate': cold_ns,\n           'excluded': ['event construction and hashing', 'CLI startup', 'disk/Git/network/process validation',\n                        'cold compilation', 'JSON serialization'],\n           'physical_costs': 'Owner validation and source checks remain outside hot operations. Test Manager logs include fixture process/config costs; production I/O is not measured.',\n           'reproduction_python': Path(__file__).read_text(),\n           'recurring_runtime_gate': False, 'authorizes_landing': False}\n(out / 'timing.json').write_text(json.dumps(receipt, indent=2) + '\\n')\nprint(json.dumps({'carrier': carrier, 'percentiles_ns': summary,\n                  'cold_compile_ns': cold_ns, 'target_met': receipt['target_met']}))\n",
