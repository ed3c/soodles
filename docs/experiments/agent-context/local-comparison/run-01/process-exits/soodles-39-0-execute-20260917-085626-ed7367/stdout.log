{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"python3 -B - <<'PY'\nimport json, os\nfrom pathlib import Path\np=Path(os.environ['NOODLE_PROJECT_DIR']).parent/'inbox'\nfor name in ['identity-input.json','runtime-readback.json','checkpoint.json','provider.json','historical-seed.json']:\n print('\\\\n'+name)\n print((p/name).read_text())\nfor k in ['NOODLE_SESSION_ID','NOODLE_ORDER_ID','NOODLE_STAGE_INDEX']:\n print(k+'='+str(os.environ.get(k)))\nPY\nrg -n 'next|resolved|reconcile|identity' tests/test_landing* soodles/landing.py landing.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
