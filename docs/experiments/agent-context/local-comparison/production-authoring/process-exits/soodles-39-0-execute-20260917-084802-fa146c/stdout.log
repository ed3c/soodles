untime admission]', 'read the relevant recipe directly: [authenticated Issue readback](features/github-read.md), [runtime admission]')\n elif p=='contracts/agent-context-design.md':\n  s=replace_once(s,'Status: experimental; matched Astra behavior has not been established.', 'Status: experimental for the current integrated inputs; earlier comparisons support only their frozen inputs, not this integration or an improvement claim.')\n  s=replace_once(s,'See [the #39 protocol](../docs/experiments/agent-context/protocol.md).','See [the historical #39 protocol](https://github.com/ed3c/soodles/blob/'+old+'/docs/experiments/agent-context/protocol.md); the current admitted Issue selects any new comparison.')\n target=root/'draft'/p\n target.parent.mkdir(parents=True,exist_ok=True)\n assert not target.exists(), str(target)\n target.write_text(s)\nprint('Created five complete external draft files.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
